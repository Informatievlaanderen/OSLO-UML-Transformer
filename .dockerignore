# OSLO Pipeline — .dockerignore
# Exclude everything from the build context except what the Dockerfile needs.
# The build context is the repo root (because Dockerfile.circleci references
# package.json, packages/, and pipeline/scripts/ from there).

# --- Git ---
.git
.gitignore
.gitattributes
.gitmodules

# --- Dependencies (installed inside the image) ---
node_modules
packages/*/node_modules

# --- Build artefacts ---
dist
lib
*.tsbuildinfo
coverage
typings

# --- Pipeline test/scratch data ---
pipeline/checkouts.txt
pipeline/links.txt
pipeline/rawcheckouts.txt
pipeline/report
pipeline/report4
pipeline/target
pipeline/src
pipeline/ttl
pipeline/json
pipeline/translation
pipeline/autotranslation
pipeline/testt

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Environment ---
.env
.env.test

# --- Misc large files ---
*.xml
*.png
*.jpg
*.jpeg
*.gif
*.tgz
*.tar.gz
*.zip